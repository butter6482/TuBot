{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "runtime": "python3.11",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "builds": [
    { "src": "chatbot-saas-frontend/Frontend/package.json", "use": "@vercel/static-build" }
  ],
  "installCommand": "cd chatbot-saas-frontend/Frontend && npm ci",
  "buildCommand": "cd chatbot-saas-frontend/Frontend && npm run build",
  "outputDirectory": "chatbot-saas-frontend/Frontend/dist"
}
